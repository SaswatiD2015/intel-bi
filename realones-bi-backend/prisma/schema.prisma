// This is your Prisma schema file for the RealOnes BI Fastify Backend.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ----------------------------------------------------------------------------
// 1. AUTHENTICATION & ACCESS
// ----------------------------------------------------------------------------

enum Role {
  ANALYST
  BUSINESS_USER
  ADMIN
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  passwordHash      String
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  userRoles         UserRole[]
  userRegionAccess  UserRegionAccess[]
  refreshTokens     RefreshToken[]
  queryRuns         QueryRun[]
  savedQuestions    SavedQuestion[]
  loginAttempts     LoginAttempt[]

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  role      Role
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model Region {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userAccess  UserRegionAccess[]
  orders      Order[]

  @@map("regions")
}

model UserRegionAccess {
  id        String   @id @default(uuid())
  userId    String
  regionId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([userId, regionId])
  @@map("user_region_access")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model LoginAttempt {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  ipAddress String?
  success   Boolean
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("login_attempts")
}

// ----------------------------------------------------------------------------
// 2. COMMERCE DATA (MOCK WAREHOUSE)
// ----------------------------------------------------------------------------

model Customer {
  id               String   @id @default(uuid())
  name             String
  email            String?  // PII
  phone            String?  // PII
  segment          String?
  createdAt        DateTime @default(now())
  dataLoadedAt     DateTime @default(now())

  orders           Order[]
  churnScores      CustomerChurnScore[]

  @@map("customers")
}

model ProductCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  products    Product[]

  @@map("product_categories")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  categoryId  String
  unitCost    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  category    ProductCategory @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@map("products")
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  RETURNED
}

model Order {
  id           String      @id @default(uuid())
  customerId   String
  regionId     String
  orderDate    DateTime
  status       OrderStatus
  createdAt    DateTime    @default(now())
  dataLoadedAt DateTime    @default(now())

  customer     Customer    @relation(fields: [customerId], references: [id])
  region       Region      @relation(fields: [regionId], references: [id])
  orderItems   OrderItem[]
  returns      Return[]

  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  productId    String
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2)
  discount     Decimal  @default(0) @db.Decimal(10, 2)

  order        Order    @relation(fields: [orderId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])
  returns      Return[]

  @@map("order_items")
}

model Return {
  id           String     @id @default(uuid())
  orderId      String
  orderItemId  String?
  returnDate   DateTime
  reason       String?
  refundAmount Decimal    @db.Decimal(10, 2)

  order        Order      @relation(fields: [orderId], references: [id])
  orderItem    OrderItem? @relation(fields: [orderItemId], references: [id])

  @@map("returns")
}

model SalesTarget {
  id          String   @id @default(uuid())
  regionId    String
  targetMonth DateTime
  targetAmount Decimal @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@unique([regionId, targetMonth])
  @@map("sales_targets")
}

model CustomerChurnScore {
  id          String   @id @default(uuid())
  customerId  String
  score       Decimal  @db.Decimal(5, 4)
  scoredAt    DateTime
  modelName   String?

  customer    Customer @relation(fields: [customerId], references: [id])

  @@map("customer_churn_scores")
}

// ----------------------------------------------------------------------------
// 3. SEMANTIC LAYER & GLOSSARY
// ----------------------------------------------------------------------------

model BusinessGlossary {
  id          String   @id @default(uuid())
  term        String   @unique
  definition  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("business_glossary")
}

model MetricDefinition {
  id                  String   @id @default(uuid())
  metricKey           String   @unique
  displayName         String
  description         String
  formulaDescription  String
  approvedSqlTemplate String
  sourceTables        String[] // E.g. ["orders", "order_items"]
  requiredJoins       String[]
  allowedDimensions   String[]
  allowedFilters      String[]
  grain               String
  synonyms            String[]
  owner               String?
  version             Int      @default(1)
  isApproved          Boolean  @default(true)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  queryRuns           QueryRun[]

  @@map("metric_definitions")
}

// Additional metadata tables as requested
model SchemaTable {
  id          String   @id @default(uuid())
  tableName   String   @unique
  description String?
  isActive    Boolean  @default(true)

  columns     SchemaColumn[]
  @@map("schema_tables")
}

model SchemaColumn {
  id          String   @id @default(uuid())
  tableId     String
  columnName  String
  dataType    String
  isPii       Boolean  @default(false)
  description String?

  table       SchemaTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  @@unique([tableId, columnName])
  @@map("schema_columns")
}

model ApprovedJoinPath {
  id          String   @id @default(uuid())
  name        String   @unique
  sourceTable String
  targetTable String
  joinCondition String
  isActive    Boolean  @default(true)

  @@map("approved_join_paths")
}

model ApprovedQueryExample {
  id          String   @id @default(uuid())
  question    String
  sql         String
  metricKey   String?
  description String?

  @@map("approved_query_examples")
}


// ----------------------------------------------------------------------------
// 4. GOVERNANCE & AI PIPELINE
// ----------------------------------------------------------------------------

enum QuestionType {
  DESCRIPTIVE
  DIAGNOSTIC
  PREDICTIVE
  CAUSAL
}

enum QueryStatus {
  RECEIVED
  NEEDS_CLARIFICATION
  PLAN_VALIDATED
  SQL_GENERATED
  SQL_BLOCKED
  SQL_VALIDATED
  EXECUTED
  EXECUTION_FAILED
  INSIGHT_GENERATED
  INSIGHT_SUPPRESSED
  COMPLETED
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum DataQualityStatus {
  GOOD
  NEEDS_ATTENTION
  HIGH_RISK
}

model QueryRun {
  id                 String       @id @default(uuid())
  userId             String
  question           String
  normalizedQuestion String
  status             QueryStatus  @default(RECEIVED)
  questionType       QuestionType?
  
  metricDefinitionId String?
  queryPlanId        String?      @unique
  sqlValidationId    String?      @unique
  dataQualityRunId   String?      @unique
  auditLogId         String?      @unique

  generatedSql       String?
  realScore          Confidence?
  scoreReasons       String?      // JSON string array
  insightJson        String?      // JSON blob of generated insight
  errorMessage       String?
  
  executionTimeMs    Int?
  rowCount           Int?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user               User         @relation(fields: [userId], references: [id])
  metricDefinition   MetricDefinition? @relation(fields: [metricDefinitionId], references: [id])
  
  plan               QueryPlan?
  validationRun      QueryValidationRun?
  dataQualityRun     DataQualityRun?
  auditLog           AuditLog?
  modelMetrics       ModelUsageMetric[]
  feedback           UserFeedback?
  decisionReviews    DecisionReview[]
  savedQuestion      SavedQuestion?

  @@map("query_runs")
}

model QueryPlan {
  id            String   @id @default(uuid())
  queryRunId    String   @unique
  planJson      String   // The validated Zod JSON object
  isValid       Boolean
  createdAt     DateTime @default(now())

  queryRun      QueryRun @relation(fields: [queryRunId], references: [id], onDelete: Cascade)

  @@map("query_plans")
}

model QueryValidationRun {
  id            String   @id @default(uuid())
  queryRunId    String   @unique
  isValid       Boolean
  astJson       String?  // Parsed AST representation
  errors        String?  // JSON string array
  warnings      String?  // JSON string array
  createdAt     DateTime @default(now())

  queryRun      QueryRun @relation(fields: [queryRunId], references: [id], onDelete: Cascade)

  @@map("query_validation_runs")
}

model DataQualityRun {
  id            String   @id @default(uuid())
  queryRunId    String   @unique
  status        DataQualityStatus
  checksJson    String   // Detailed checks output
  summary       String?
  createdAt     DateTime @default(now())

  queryRun      QueryRun @relation(fields: [queryRunId], references: [id], onDelete: Cascade)

  @@map("data_quality_runs")
}

model AuditLog {
  id            String   @id @default(uuid())
  queryRunId    String?  @unique
  userId        String?
  action        String   // e.g. "query_blocked", "login_failed", "insight_suppressed"
  resourceType  String?
  resourceId    String?
  details       String?  // JSON payload
  ipAddress     String?
  createdAt     DateTime @default(now())

  queryRun      QueryRun? @relation(fields: [queryRunId], references: [id])

  @@map("audit_logs")
}

model UserFeedback {
  id            String   @id @default(uuid())
  queryRunId    String   @unique
  userId        String
  isHelpful     Boolean
  comments      String?
  createdAt     DateTime @default(now())

  queryRun      QueryRun @relation(fields: [queryRunId], references: [id])

  @@map("user_feedback")
}

model DecisionReview {
  id               String   @id @default(uuid())
  queryRunId       String?
  savedQuestionId  String?
  userId           String
  decisionMade     String
  expectedImpact   String?
  status           String   @default("LOGGED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  queryRun         QueryRun? @relation(fields: [queryRunId], references: [id])
  savedQuestion    SavedQuestion? @relation(fields: [savedQuestionId], references: [id])

  @@map("decision_reviews")
}

model SavedQuestion {
  id               String   @id @default(uuid())
  userId           String
  queryRunId       String?  @unique
  title            String
  question         String
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id])
  queryRun         QueryRun? @relation(fields: [queryRunId], references: [id])
  decisionReviews  DecisionReview[]

  @@map("saved_questions")
}

model ModelUsageMetric {
  id              String   @id @default(uuid())
  queryRunId      String?
  modelName       String
  promptVersion   String?
  step            String   // e.g. 'planning', 'sql', 'insight'
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  totalTokens     Int      @default(0)
  latencyMs       Int      @default(0)
  estimatedCost   Decimal  @default(0) @db.Decimal(10, 6)
  createdAt       DateTime @default(now())

  queryRun        QueryRun? @relation(fields: [queryRunId], references: [id])

  @@map("model_usage_metrics")
}

model BlockedQueryEvent {
  id               String   @id @default(uuid())
  userId           String
  attemptedSql     String?
  reason           String
  metadata         String?  // JSON
  createdAt        DateTime @default(now())

  @@map("blocked_query_events")
}

model AppSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("app_settings")
}
