NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:password@localhost:5432/realones_bi
DIRECT_DATABASE_URL=postgresql://postgres:password@localhost:5432/realones_bi

JWT_ACCESS_SECRET=replace_me_with_a_secure_secret_key_123!
JWT_REFRESH_SECRET=replace_me_with_another_secure_secret_key_456!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=15000

QUERY_TIMEOUT_MS=5000
QUERY_LOCK_TIMEOUT_MS=1000
QUERY_MAX_ROWS=1000
QUERY_MAX_DETAIL_ROWS=200

CACHE_PROVIDER=memory
REDIS_URL=
CACHE_TTL_SECONDS=300

PII_HASH_SALT=replace_me_with_a_salt_for_pii_hashing
PROMPT_VERSION=query-planner-v1
